# Copy this file to .env for local development, then fill in values locally.
# Never commit .env or put the Razorpay Key Secret in frontend variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace_with_a_long_random_secret
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_ROTATED_TEST_SECRET
