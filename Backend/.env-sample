# Copy to .env locally or configure these variables in your backend host.
# Replace placeholders locally. Never commit real credentials or private keys.

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Firebase service account JSON encoded as base64, if required by your deployment.
FIREBASE_CREDENTIALS_BASE64=REPLACE_WITH_BASE64_ENCODED_FIREBASE_SERVICE_ACCOUNT_JSON

# Razorpay Test Mode credentials. Rotate any secret that has been shared.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_ROTATED_TEST_SECRET
